{
  "name": "ppu-indra-ocr",
  "version": "0.1.1",
  "description": "TypeScript SDK for Datalab's Indra OCR models: page orientation, line detection, recognition (Latin, Cyrillic, Greek, Devanagari, Bengali, Chinese), reading order, layout blocks, markdown, optional math, and PDF text layers. Runs on Node.js, Bun, Deno, browsers, web workers and React Native via ONNX Runtime.",
  "keywords": [
    "accurate-ocr",
    "browser-ocr",
    "bun-compatible",
    "bun-ocr",
    "computer-vision",
    "document-ai",
    "document-analysis",
    "document-processing",
    "fast-ocr",
    "image-processing",
    "image-text-extraction",
    "image-to-text",
    "invoice-processing",
    "javascript-ocr",
    "lightweight-ocr",
    "node-ocr",
    "nodejs-ocr",
    "ocr",
    "ocr-engine",
    "ocr-library",
    "onnx",
    "onnx-ocr",
    "onnxruntime",
    "optical-character-recognition",
    "receipt-scanner",
    "text-detection",
    "text-extraction",
    "text-from-image",
    "text-recognition",
    "typescript-ocr",
    "web-ocr",
    "docker-ocr",
    "cli-ocr",
    "react-native",
    "react-native-ocr",
    "web-worker-ocr",
    "indra-ocr",
    "layout-analysis",
    "reading-order",
    "pdf-to-markdown",
    "document-parsing",
    "markdown"
  ],
  "author": "snowfluke",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "ppu-indra-ocr": "cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./web": {
      "types": "./web/index.d.ts",
      "default": "./web/index.js"
    },
    "./mobile": {
      "types": "./mobile/index.d.ts",
      "default": "./mobile/index.js"
    },
    "./pdf": {
      "types": "./pdf/index.d.ts",
      "default": "./pdf/index.js"
    },
    "./coi-serviceworker.js": "./coi-serviceworker.js"
  },
  "scripts": {
    "task": "bun scripts/task.ts",
    "bump": "bun scripts/bump.ts",
    "build": "bun task build",
    "build:test": "bun task build && bun run test",
    "build:publish": "bun task build && bun task report-size && bun task publish",
    "build:pages": "bun task build && bun run playground/build-pages.ts",
    "clear-cache": "bun scripts/clear-cache.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt .",
    "demo": "bun run playground/serve.ts",
    "prepare": "lefthook install --reset-hooks-path"
  },
  "devDependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@napi-rs/canvas": "^1.0.8",
    "@oxlint/plugins": "1.83.0",
    "@types/bun": "^1.4.2",
    "@types/uglify-js": "^3.17.5",
    "canvas": "^3.2.3",
    "fast-check": "^4.9.0",
    "lefthook": "^2.1.12",
    "onnxruntime-common": "^1.29.0",
    "onnxruntime-node": "^1.29.0",
    "onnxruntime-web": "^1.29.0",
    "oxfmt": "^0.67.0",
    "oxlint": "1.83.0",
    "ppu-paddle-ocr": "6.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "uglify-js": "^3.19.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PT-Perkasa-Pilar-Utama/ppu-indra-ocr.git"
  },
  "homepage": "https://github.com/PT-Perkasa-Pilar-Utama/ppu-indra-ocr#readme",
  "dependencies": {
    "ppu-ocv": "^4.0.0"
  },
  "peerDependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@shopify/react-native-skia": ">=1.0.0",
    "onnxruntime-node": "^1.23.2",
    "onnxruntime-react-native": "^1.23.2",
    "onnxruntime-web": "^1.23.2"
  },
  "peerDependenciesMeta": {
    "@embedpdf/pdfium": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    },
    "onnxruntime-react-native": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    }
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  }
}
