# --- Runtime ---
API_ENV="development"            # development | production
PORT=8080
HOST="0.0.0.0"

# --- Security ---
# Bearer credential for /v1/* routes. Leave empty to disable auth (dev only).
# Generate one with: openssl rand -hex 32
SECRET_KEY=

# Comma-separated client IP rules. "*" allows all; the deny list still applies.
IP_WHITE_LIST="*"
IP_DENY_LIST=""

# Comma-separated allowed CORS origins, or "*".
CORS_ORIGINS="*"

# Serve /docs (Scalar) and /openapi.json. Disable in locked-down deployments.
DOCS_ENABLED="true"

# --- Rate limiting (fixed window, per client IP) ---
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_PER_WINDOW=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Request limits ---
REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=10485760        # 10 MB per image or PDF
MAX_IMAGE_PIXELS=40000000
MAX_BATCH_IMAGES=32

# --- OCR engine / models ---
EXECUTION_PROVIDERS="cpu"        # e.g. "cuda,cpu" on the CUDA image
DEFAULT_ENGINE="opencv"          # opencv | canvas-native
MODEL="v1.1"                     # model preset: v1.1 (Indra OCR 1.1) | v3.1 (1.0, smaller)
# A folder with the Indra model files; omit to use the cached default download.
MODEL_DIR=
LM="true"                        # re-read unsure lines with the language models (v1.1)
MATH="false"                     # write math as LaTeX (loads 4 more models)
KEEP_FURNITURE="false"           # keep page headers and footers in the markdown
PDF_DPI=200                      # render resolution for OCR of PDF pages
MAX_PDF_PAGES=50                 # pages read per PDF

# --- Inference backpressure / async tasks ---
MAX_CONCURRENCY=0                # 0 = auto (1: each page allocates large tensors)
MAX_QUEUE_DEPTH=100              # excess requests get 429 + Retry-After
TASK_TTL_SECONDS=600

# --- Source fetching ---
# Comma-separated https hosts allowed as a JSON `source`. Empty = https disabled
# (uploads and data: URIs always work). Local paths are always rejected.
SOURCE_URL_ALLOWLIST=""
